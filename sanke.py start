import pygame

pygame.init()

screen = pygame.display.set_mode((600, 600))

BLACK = (0, 0 ,0)
running = True

def draw_game(board):
	for index , i in enumerate(board):
		for cell_index , j in enumerate(i):
			if j is not None:
					
				if j.lower() == "s":
					pygame.draw.rect(screen , (0 ,255 , 0) , (cell_index * 40 , index *40 , 40 , 40))	
					
				elif j.lower() == "f":
					pygame.draw.rect(screen , (255 , 0 ,0) , (cell_index * 40 , index *40 , 40 , 40))	
				pygame.display.flip()
	
	
