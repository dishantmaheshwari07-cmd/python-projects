			pending += 1
			
		actual_time += i.get("actual_study_time", 0)
		total_time += i.get("time", 0)
	
	subjects_list = []
	
	for i in data:
		task_subject = i["subject"].lower()[0:3]
		
		if not subjects_list:
			subjects_list.append({task_subject: [i]})
		
		else:
			found = False
			
			for subject in subjects_list:
