def digital_dict():
	while True:

		word = input(
			"\n📖 Enter word or 'exit' : "
		).strip().lower()

		if word == "exit":
			return

		if not word:
			print("\n❌ Please enter a valid word.")
			continue

		spell = SpellChecker()
		word = spell.correction(word)

		print(f"\n🔎 Searching meaning for : {word}")

		url = (
			f"https://api.dictionaryapi.dev/api/v2/"
			f"entries/en/{word}"
		)

		try:
			r = requests.get(url, timeout=15)
			if r.status_code == 200:
				data = r.json()

				if data and isinstance(data, list):
					meanings = data[0].get("meanings", [])
					if meanings:
						definitions = meanings[0].get("definitions", [])
						if definitions:

							print("\n" + "=" * 40)
							print("			 📖 DIGITAL DICTIONARY")
							print("=" * 40)

							print(f"\n🔤 Word	   : {word}")
							print(
								f"📚 Meaning	: "
								f"{definitions[0].get('definition')}"
							)

							print("\n" + "=" * 40)

						else:
							print(
								"\n❌ No definition found "
								"for this word."
							)

					else:
						print("\n❌ No meaning found for this word.")

				else:
					print("\n❌ Unexpected data received from server.")

			elif r.status_code == 404:

				print(
					f"\n❌ The word '{word}' "
					"was not found in the dictionary."
				)

			else:
				print(
					f"\n⚠️ Server error. "
					f"Status code: {r.status_code}"
				)
		except requests.exceptions.ConnectionError:
			print(
				"\n🌐 Network Error."
				"\n👉 Please check your internet connection."
			)

		except requests.exceptions.Timeout:

			print(
				"\n⏳ Request timed out."
				"\n👉 Please try again later."
			)

		except requests.exceptions.RequestException as e:

			print(f"\n❌ Network error: {e}")

		except Exception as e:

			print(f"\n❌ Unexpected error: {e}")
			
def food_nutrients():
	while True:

		food = input(
			"\n🥗 Enter food name or 'exit' : "
		).strip()

		if food.lower() == "exit":
			return

		if not food:
			print("\n❌ Please enter a food name.")
			continue

		print("\n🔎 Searching nutrition information...")

		url = (
			f"https://api.nal.usda.gov/fdc/v1/foods/search?"
			f"api_key=DEMO_KEY&query={food}"
		)

		try:
			r = requests.get(url, timeout=15)
			data = r.json()

			if "foods" in data and len(data["foods"]) > 0:

				print("\n" + "=" * 45)
				print("			 🥗 STUDENT NUTRITION")
				print("=" * 45)

				print(f"\n🍽️ Food : {food}")
				print("-" * 45)
				print("		📊 NUTRITION PER 100 GRAMS")
				print("-" * 45)

				nutrient_data = data["foods"][0]["foodNutrients"]

				for i in nutrient_data:

					name = i.get("nutrientName")
					value = i.get("value")
					unit = i.get("unitName")

					print(
						f"🔹 {name:<35} : "
						f"{value} {unit}"
					)
					print("\n" + "=" * 45)
			else:
				print(
					f"\n❌ Food '{food}' "
					"was not found."
				)
		except requests.exceptions.RequestException:

			print(
				"\n🌐 Network error."
				"\n👉 Please check your internet connection."
			)
		except Exception as e:
			print(f"\n❌ Unexpected error: {e}")
				
