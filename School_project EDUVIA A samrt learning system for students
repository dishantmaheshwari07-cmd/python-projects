def int_input(message):
	while True:
		try:
			return int(input(message))
		except ValueError:
			print("\n❌ Enter a valid number.\n")


def save_data(data):
	# Whole data to save
	with open("student_task.json", "w") as f:
		json.dump(data, f, indent=4)


def load_data():
	if os.path.exists("student_task.json"):
		with open("student_task.json", "r") as f:
			return json.load(f)
	return []


def calc_smart_score(days_left, difficulty):
	difficulty_scores = {
		"easy": 30,
		"medium": 60,
		"hard": 100
	}

	# Calculate urgency
	urgency = max(20, 100 - ((days_left // 2) * 10))

	while True:
		try:
			difficulty_score = difficulty_scores[difficulty]
			break

		except KeyError:

			if difficulty.startswith("e"):
				difficulty = "easy"

			elif difficulty.startswith("m"):
				difficulty = "medium"

			elif difficulty.startswith("h"):
				difficulty = "hard"

			else:
				difficulty = input(
					"\n❌ Enter difficulty (Easy, Medium, Hard): "
				).lower()

	return (urgency + difficulty_score) / 2


def update_data(subject, topic, exam_date, difficulty):

	data = load_data()
	task_id = len(data) + 1

	task = {
		"id": task_id,
		"subject": subject,
		"topic": topic,
		"exam_date": exam_date,
		"difficulty": difficulty,
		"completed": False,
		"created_at": datetime.now().strftime("%Y-%m-%d %H:%M:%S")
	}

	data.append(task)

	with open("student_task.json", "w") as f:
		json.dump(data, f, indent=4)

	return task_id


