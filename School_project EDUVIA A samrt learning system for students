def smart_study():

	data = load_data()

	if not data:
		print("\n📭 No task found.\n")
		return

	print("\n" + "=" * 35)
	print("	   🧠 TODAY'S SMART PLAN")
	print("=" * 35)

	total_study_time = int_input(
		"⏱️ Enter estimated study time for today (minutes) : "
	)

	while total_study_time < 30:

		print("\n⚠️ Study time should be at least 30 minutes.")

		total_study_time = int_input(
			"⏱️ Enter today's study time (minimum 30 minutes) : "
		)

	not_compl = []
	valid_task = []

	for i in data:

		if not i["completed"]:
			not_compl.append(i)

	if not not_compl:
		print("\n🎉 All given tasks are completed!\n")
		return

	total_score = 0

	for i in not_compl:
		days_left = calculate_date(i["exam_date"])

		if days_left < 0:
			print(
				f"\n⚠️ Date already passed for "
				f"{i['subject']} -> {i['topic']}"
			)

		else:
			smart_score = calc_smart_score (days_left, i["difficulty"])
			
			i["smart_score"] = smart_score
			total_score += smart_score
			valid_task.append(i)

	not_compl = valid_task
	valid_task = []
	left_time = 0
	extra_time = 0

	for i in not_compl:
		smart_score = i["smart_score"]

		time =(smart_score / total_score)* total_study_time
		left_time += time - int(time)
		time = int(time)

		if time < 10:
			extra_time += time

		else:
			i["time"] = time
			index = data.index(i)
			data[index]["time"] = time
			
			valid_task.append(i)

	not_compl = valid_task

	try:

		single_extra_time = int(
			extra_time / len(not_compl)
		)
		
	except ZeroDivisionError:

		print(
			"\n📭 No upcoming tasks available. "
			"All pending tasks have passed their exam date.\n"
		)
		return
		
	for i in not_compl:
		
		i["time"] += single_extra_time
		index = data.index(i)
		data[index]["time"] += single_extra_time
		data[index]["plan_date"] = str(date.today())

	print("\n" + "-" * 45)
	print("		  🧠 TODAY'S SMART WORK")
	print("-" * 45)

	for index, i in enumerate(not_compl, start=1):

		if index == 1:
			i["time"] += left_time
			index = data.index(i)
			data[index]["time"] += left_time

		print(
			f"\n{index}. 📚 {i['subject']} → {i['topic']}"
		)

		print(f"   ⏱️ Time	   : {i['time']} minutes")
		print(f"   ⭐ Importance : {i['smart_score']}%")
		print("-" * 45)
		
	print()
	save_data(data)

current_session = None

def start_session():
	global current_session
	
	if current_session:
		print("\n⚠️ A study session is already running.")
		print("❌ Stop the current session before starting another.\n")
		return
	
	data = load_data()
	pending = []
	
	for i in data:
		if not i["completed"]:
			left_days = calculate_date(i["exam_date"])
			
			if left_days >= 0:
				pending.append(i)
	
	if not pending:
		print("\n📭 No pending study task found.\n")
		return
	
	print("\n" + "=" * 40)
	print("		⏱️ AVAILABLE STUDY SESSIONS")
	print("=" * 40)
	
	for index, i in enumerate(pending, start=1):
		try:
			print(
				f"\n{index}. 📚 {i['subject']} → {i['topic']}"
				f"\n   ⏱️ Planned Time : {i['time']} min"
			)
		
		except KeyError:
			print(
				"\n❌ Study time not found for this task."
				"\n👉 First create Today's Smart Plan."
			)
			return
	
	print("\n" + "-" * 40)
	
	select = int_input(
		"👉 Enter session number : "
	)
	
	while True:
		if 0 < select < len(pending) + 1:
			
			session = pending[select - 1]
			
			print("\n" + "=" * 40)
			print("		▶️ STUDY SESSION STARTED")
			print("=" * 40)
			print(
				f"📚 Subject : {session['subject']}"
				f"\n📝 Topic   : {session['topic']}"
				f"\n⏱️ Target  : {session['time']} min"
			)
			print("=" * 40)
			
			start_time = time.time()
			planned_time = session["time"] * 60
			
			current_session = {
				"id": session["id"],
				"start_time": start_time,
				"planned_time": planned_time
			}
			
			break
		
		else:
			select = int_input(
				"❌ Invalid session number. Enter again : "
			)
	
