def stop_session():
	global current_session

	if current_session is None:
		print("\n❌ No study session is running.\n")
		return

	data = load_data()	

	for i in data:
		if i["id"] == current_session["id"]:

			elapsed = int(
				(time.time() - current_session["start_time"]) / 60
			)

			i["actual_study_time"] = (
				i.get("actual_study_time", 0) + elapsed
			)

			save_data(data)

			print(
				f"\n✅ Session stopped!"
				f"\n📚 {i['subject']} → {i['topic']}"
				f"\n⏱️ Session Time : {elapsed} min"
				f"\n📋 Planned Time : "
				f"{current_session['planned_time'] // 60} min"
				f"\n📊 Total Study Time : "
				f"{i['actual_study_time']} min"
			)

			if elapsed > current_session["planned_time"] // 60:
				print("⚠️ You studied more than planned time!")

			current_session = None
			return

	print("\n❌ Session task could not be found.\n")	

