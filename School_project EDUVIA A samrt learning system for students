def calculate_date(test_date=None):

	today = date.today()

	if not test_date:

		test_date = input(
			"📅 Enter date (YYYY-MM-DD) of test/Exam : "
		)

		while True:
			try:
				target_date = datetime.strptime(
					test_date,
					"%Y-%m-%d"
				).date()

				if (target_date - today).days < 0:
					print("\n❌ Existing date isn't allowed.\n")

					test_date = input(
						"📅 Enter a future date (YYYY-MM-DD) : "
					)

				else:
					return target_date

			except ValueError:
				print("\n❌ Wrong format!")

				test_date = input(
					"📅 Enter date in YYYY-MM-DD format "
					"(like: 2026-12-31): "
				)

	target_date = datetime.strptime(
		test_date,
		"%Y-%m-%d"
	).date()

	difference = target_date - today
	days_left = difference.days

	if days_left > 0:
		return days_left

	elif days_left == 0:
		return 0

	else:
		return -1


